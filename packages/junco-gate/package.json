{
  "name": "junco-gate",
  "version": "0.2.0",
  "description": "An owner's policy in front of any MCP server's tools: allow, hold for approval, or deny; holds bound to the exact call; re-check before an approved call runs; an action log. As a command: junco-gate --paypal puts it in front of PayPal's hosted MCP server.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./paypal": "./dist/paypal.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agents",
    "approval",
    "policy",
    "human-in-the-loop"
  ],
  "bin": {
    "junco-gate": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esbuilds/junco.git",
    "directory": "packages/junco-gate"
  }
}
